# ===================================================================
# DEMS Production & Deployment Environment Variables Template (.env.example)
# Copy this file to .env and configure real secrets for production.
# NEVER commit .env or actual production credentials to source control.
# ===================================================================

# Application Server Port & Active Profile
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dems_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_SSL_MODE=prefer
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Authentication Security
# Must be a 256-bit (64-character hexadecimal) secret string
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Persistent Object Storage Configuration (S3 / Cloudflare R2 / MinIO / DigitalOcean Spaces)
# Options: 'local' for local disk filesystem, 's3' for persistent cloud object storage
STORAGE_PROVIDER=s3
STORAGE_BUCKET=dems-evidence
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=https://your-s3-compatible-endpoint.com

# AWS SDK Credential Resolution (Resolved natively by AWS SDK DefaultCredentialsProvider)
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_access_key

# Production CORS Policy
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
